DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tablewise
OPENAI_API_KEY=sk-your-openai-key
PORT=5000

# Safe defaults. These do not authorize publication or customer invitations.
TABLEWISE_PUBLIC_CATALOG_REVIEWED=false
TABLEWISE_AI_ENABLED=false
TABLEWISE_ANALYTICS_ENABLED=false
# Optional operator credential: set a high-entropy value of 32-256 characters
# using workspace Secrets, never commit a real value or use a VITE_* variable.
TABLEWISE_OPERATOR_TOKEN=
