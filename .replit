run = "npm run dev"
modules = ["nodejs-20", "postgresql-16"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
packages = ["vim"]
channel = "stable-25_05"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TableWise researched preview"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "validate"

[[workflows.workflow]]
name = "TableWise researched preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:researched"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "validate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run validate"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.production]
TABLEWISE_PUBLIC_CATALOG_REVIEWED = "true"
